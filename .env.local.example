# Copy this file to .env.local and fill in your keys, then restart `npm run dev`.

# Free Adzuna developer keys: https://developer.adzuna.com (sign up -> Dashboard -> API keys)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country to search: us, gb, ca, au, de, fr, in, ... (default: us)
ADZUNA_COUNTRY=us

# Optional local AI review (free, runs on your computer): https://ollama.com
# If Ollama is running, the first installed chat model is used automatically.
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434
